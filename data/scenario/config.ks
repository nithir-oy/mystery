[config]

; ---------------------------------------------------------
; 画面解像度・表示設定
; ---------------------------------------------------------
; 背景画像のサイズ（1376x768）に完全一致させます
screen_width = 1376
screen_height = 768

; 画面のフィット方式（keep_ratio = アスペクト比を維持して画面内に収める）
screen_layout = "keep_ratio"

; デバッグモードの有効化（開発中は true にしておくと便利です）
debug = true


; ---------------------------------------------------------
; セーブ・ロード・システム設定
; ---------------------------------------------------------
; セーブデータの保存数
save_file_list_max = 20

; メッセージ速度の初期値（ミリ秒）
ch_speed = 30


; ---------------------------------------------------------
; フォント設定
; ---------------------------------------------------------
default_font_color = "white"
default_font_size = 24
font_family = "sans-serif"


; ---------------------------------------------------------
; 初期シナリオファイルの設定
; ---------------------------------------------------------
; ゲーム起動時に最初に読み込むファイル（通常は first.ks）
first_scenario = "first.ks"